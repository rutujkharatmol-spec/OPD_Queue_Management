# ── Primary database (required) ───────────────────────────────────────────────
# Whatever this instance treats as its source of truth.
#
# On the OPD server (the deployment that must survive an internet outage) this is
# the LOCAL Postgres running on the same machine:
DATABASE_URL="postgresql://opd:password@127.0.0.1:5432/opd"
#
# In the cloud mirror deployment this is Neon instead.

# ── Cloud mirror (optional) ───────────────────────────────────────────────────
# Set ONLY on the on-prem OPD server. Points at Neon, which receives a best-effort
# background copy of local data for backup, reporting and the patient phone view.
# Leave unset for a pure-offline install, or for the cloud instance itself.
# Sync never blocks OPD operation — if the internet is down it simply retries later.
# CLOUD_SYNC_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Port the API listens on (defaults to 4000).
# PORT=4000
