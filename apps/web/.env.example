# ── 1. Local Hospital / On-Premise PostgreSQL (Local Machine / OPD Server) ───
LOCAL_DATABASE_URL="postgresql://opd:opd@127.0.0.1:55432/opd_prisma"

# ── 2. Cloud / Neon PostgreSQL (Online Sync / Vercel Deployment) ────────────
# Paste your Neon or Vercel Postgres connection string below:
NEON_DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Admin page (/admin) ────────────────────────────────────────────────────
# Password for /admin, /settings and /analytics. Set it here on the OPD server and in
# the Vercel project's Environment Variables. Never commit the real value.
# ADMIN_PASSWORD="change-me"

# ── Staff screens (registration, doctor, doctor desk) ───────────────────────
# Required. Every change to the queue (issuing tokens, calling, done, absent, deleting,
# room settings) is refused until a device logs in with this password. Set it on the
# OPD server and in Vercel. Use at least 8 characters; changing it signs out every device.
# STAFF_PASSWORD="change-me-too"

# ── Read-only copy (Vercel only, later) ────────────────────────────────────
# Leave OFF while staff work on Vercel. Once the OPD server is the live system, set
# READ_ONLY_MIRROR=true in Vercel so the queue can only be changed on the OPD server.
# Never set it on the OPD server. OPD_SERVER_URL is shown to staff on the read-only copy.
# READ_ONLY_MIRROR="true"
# OPD_SERVER_URL="http://192.168.1.50:3000"
