# Pick ONE of the two modes below. A production build fails if neither is set.

# ── Mode 1: on-prem OPD server (recommended for the hospital) ─────────────────
# The web app and API run on the same machine, so proxy to it over loopback.
# Terminals then just browse to http://<server-ip>:3000 — the server's IP is never
# baked into the client bundle, so changing it needs no rebuild.
API_PROXY_TARGET="http://127.0.0.1:4000"

# ── Mode 2: cloud mirror on Vercel (patient view for phones on mobile data) ───
# The browser calls this origin directly. No trailing slash, no /api/v1 suffix.
# NEXT_PUBLIC_* is inlined at build time, so redeploy after changing it.
# NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"

# Local development needs neither: requests fall back to http://127.0.0.1:4000.
